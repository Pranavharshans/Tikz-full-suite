{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1/training-metrics.schema.json",
  "title": "Stage 1 training metrics",
  "type": "object",
  "required": ["schema_version", "gate", "identity_sha256", "model_id",
               "optimizer_steps", "supervised_tokens_seen"],
  "properties": {
    "schema_version": { "const": "stage1-training-metrics-v1" },
    "status": { "enum": ["failed"] },
    "error": { "type": "string" },
    "gate": { "enum": ["overfit-100", "smoke-1000", "full"] },
    "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data_identity_sha256": { "type": "string" },
    "model_id": { "type": "string" },
    "model_revision": { "type": "string" },
    "adapter": { "type": "string" },
    "gate_settings": { "type": "object" },
    "resumed_from": { "type": ["string", "null"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "examples": { "type": "integer", "minimum": 0 },
    "eval_examples": { "type": "integer", "minimum": 0 },
    "planned_supervised_tokens": { "type": "integer", "minimum": 0 },
    "supervised_tokens_seen": { "type": "integer", "minimum": 0 },
    "optimizer_steps": { "type": "integer", "minimum": 0 },
    "epochs_completed": { "type": "number", "minimum": 0 },
    "num_input_tokens_seen": { "type": ["integer", "null"], "minimum": 0 },
    "final_eval_loss": { "type": ["number", "null"] },
    "last_logged_loss": { "type": ["number", "null"] },
    "peak_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "train_seconds": { "type": ["integer", "null"] },
    "supervised_tokens_per_second": { "type": ["number", "null"] },
    "load_report": { "type": ["object", "null"] },
    "log_history": { "type": "array" },
    "training": { "type": "object" },
    "metrics_path": { "type": "string" }
  }
}
