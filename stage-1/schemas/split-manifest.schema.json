{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1/split-manifest.schema.json",
  "title": "Stage 1 split manifest",
  "type": "object",
  "required": ["schema_version", "created_at", "tool_version", "seed", "splits",
               "counts", "group_count", "rows", "split_manifest_sha256",
               "data_identity"],
  "properties": {
    "schema_version": { "const": "stage1-prepared-v1" },
    "created_at": { "type": "string" },
    "tool_version": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "splits": {
      "type": "object",
      "required": ["validation_fraction", "test_fraction"],
      "properties": {
        "validation_fraction": { "type": "number", "minimum": 0, "maximum": 0.99 },
        "test_fraction": { "type": "number", "minimum": 0, "maximum": 0.99 }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 1 },
        "validation": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "group_count": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_row_index", "group_id", "split"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_row_index": { "type": "integer", "minimum": 0 },
          "group_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "split": { "enum": ["train", "validation", "test"] }
        },
        "additionalProperties": false
      }
    },
    "split_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "data_identity": {
      "type": "object",
      "required": ["schema_version", "dataset_logical_sha256",
                   "split_manifest_sha256", "seed", "row_count", "sha256"],
      "properties": {
        "schema_version": { "const": "stage1-prepared-v1" },
        "dataset_logical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "split_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "seed": { "type": "integer" },
        "row_count": { "type": "integer", "minimum": 1 },
        "complete_rows": { "type": "integer", "minimum": 0 },
        "source_dataset": { "type": "string" },
        "source_revision": { "type": "string" },
        "splits": { "type": "object" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
