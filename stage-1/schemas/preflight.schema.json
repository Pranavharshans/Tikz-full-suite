{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1/preflight.schema.json",
  "title": "Stage 1 preflight report",
  "type": "object",
  "required": ["schema_version", "created_at", "identity_sha256", "status",
               "complete", "checks"],
  "properties": {
    "schema_version": { "const": "stage1-preflight-v1" },
    "created_at": { "type": "string" },
    "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "complete": { "type": "boolean" },
    "failed": { "type": "array", "items": { "type": "string" } },
    "skipped": { "type": "array", "items": { "type": "string" } },
    "peak_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "load_report": { "type": ["object", "null"] },
    "data_identity_sha256": { "type": "string" },
    "started_training": { "const": false },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": { "type": "string" },
          "requires": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["pass", "fail", "skip"] },
          "detail": { "type": "string" },
          "data": { "type": "object" }
        }
      }
    }
  }
}
